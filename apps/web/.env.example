# Optional settings for apps/web (copy to .env.local; never commit secrets). Every value here is public: Vite puts
# VITE_* values into the built JavaScript, so a token or password must never go in this file.

# Hosted view layer the app reads results from. Leave empty to use the production view (ADR 0004); set it to point at the dev service.
VITE_AGOL_VIEW_URL=

# Where results come from: "replay" (the 2022 replay, marked Replay on screen) or "agol". Leave empty for replay in dev and agol in a build.
VITE_RESULTS_SOURCE=

# Static latest.json pointer (ADR 0016). Leave empty until the ingest Function publishes one (VE-55).
VITE_LATEST_URL=

# Build only: the sub-path the site is served from, with slashes either side, for example /vic26election/. Empty means /.
BASE_PATH=

# Optional: an outside forecast site (https) the Explore sheet links to as "Polling model". Leave empty and the card is not shown.
VITE_FORECAST_URL=
